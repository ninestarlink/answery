# ===== 应用 =====
APP_ENV=dev
# 生产环境务必替换为随机字符串，例如 python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
JWT_EXPIRE_MINUTES=1440
# 演示账号统一密码（管理员 13800001234 / 普通客户 13900002345）
# 数据库里已有 bcrypt 哈希的账号优先走哈希校验，未配置哈希时回落到该值
DEMO_PASSWORD=demo1234
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== MySQL（与 docker-compose.yml 保持一致）=====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ecom
MYSQL_PASSWORD=ecom123456
MYSQL_DB=ecom_ai_demo

# ===== Redis =====
REDIS_URL=redis://127.0.0.1:6379/0

# ===== 自建 RAG（pgvector，独立容器，端口 5433）=====
PG_DSN=postgresql://rag:rag123456@127.0.0.1:5433/rag
RAG_EMBEDDING_DIMS=1024

# ===== 对话模型（默认硅基流动，智谱配置保留备用）=====
# CHAT_PROVIDER 可选 siliconflow / zhipu
CHAT_PROVIDER=siliconflow
SILICONFLOW_CHAT_MODEL=deepseek-ai/DeepSeek-V3.2
# 在 https://open.bigmodel.cn 控制台创建 API Key
ZHIPU_API_KEY=
ZHIPU_CHAT_MODEL=glm-4-flash

# ===== 向量化 / 精排（默认硅基流动，与对话模型分开计费）=====
# EMBEDDING_PROVIDER 可选 siliconflow / zhipu
EMBEDDING_PROVIDER=siliconflow
SILICONFLOW_API_KEY=
SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1
# bge-m3 输出 1024 维，与 RAG_EMBEDDING_DIMS 一致
SILICONFLOW_EMBEDDING_MODEL=Pro/BAAI/bge-m3
SILICONFLOW_RERANK_MODEL=Pro/BAAI/bge-reranker-v2-m3
# provider=zhipu 时才使用下面两个
ZHIPU_EMBEDDING_MODEL=embedding-3
ZHIPU_RERANK_MODEL=rerank

# ===== 对话与工单 =====
# 携带最近几轮上下文（1 轮 = 一问一答）
HISTORY_ROUNDS=3
# 工单 AI 分析超时（秒）
TICKET_AI_TIMEOUT=15

# ===== 代码执行沙箱（需要本机 Docker 可用）=====
# 设为 false 可完全关闭；关闭后 /api/sandbox/run 返回 503
SANDBOX_ENABLED=true
# 单次执行超时（秒），超时直接销毁并重建容器
SANDBOX_TIMEOUT=8
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1.0
SANDBOX_CODE_LIMIT=4000
# 同一段代码的结果缓存时间与单账号 10 分钟额度
SANDBOX_CACHE_TTL=600
SANDBOX_QUOTA=20
